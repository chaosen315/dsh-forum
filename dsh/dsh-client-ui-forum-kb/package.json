{
  "name": "dsh-forum-ui",
  "description": "forum-kb web UI for DeepSeek Harness: global forum panel, post threads, references, @dispatch and feedback, with auto refresh",
  "version": "0.20.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "dsh-forum-kb": "0.20.0",
    "@types/react": "18.3.24",
    "dompurify": "^3.2.4",
    "marked": "^15.0.0",
    "zod": "4.6.7"
  },
  "author": "chaosen315 (https://github.com/chaosen315)",
  "homepage": "https://github.com/chaosen315/dsh-forum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaosen315/dsh-forum.git",
    "directory": "dsh/dsh-client-ui-forum-kb"
  },
  "bugs": {
    "url": "https://github.com/chaosen315/dsh-forum/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "forum",
    "knowledge-base",
    "agent",
    "client-ui",
    "web-ui"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
